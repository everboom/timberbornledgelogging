<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>LedgeLogging</RootNamespace>
    <AssemblyName>LedgeLogging</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Harmony for runtime patching. Compile-only: the runtime DLL is provided by
    the player's installed Harmony mod (declared in manifest.json RequiredMods),
    so we don't bundle it. This is the Timberborn ecosystem convention.
  -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Game / engine references resolved from the local Timberborn install. These
    are NOT redistributed (Private=false) — Timberborn itself provides them at
    load time. Wildcards expand at item-evaluation time.
  -->
  <ItemGroup Label="Timberborn DLLs">
    <Reference Include="$(TimberbornManagedDir)\Timberborn.*.dll">
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="$(TimberbornManagedDir)\Bindito.Core.dll;$(TimberbornManagedDir)\Bindito.Unity.dll">
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="$(TimberbornManagedDir)\Unity.Mathematics.dll;$(TimberbornManagedDir)\Unity.Collections.dll;$(TimberbornManagedDir)\Unity.Burst.dll">
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="$(TimberbornManagedDir)\System.Collections.Immutable.dll;$(TimberbornManagedDir)\Newtonsoft.Json.dll">
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="Unity engine DLLs">
    <Reference Include="$(TimberbornManagedDir)\UnityEngine.dll;$(TimberbornManagedDir)\UnityEngine.*Module.dll">
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="$(TimberbornManagedDir)\Unity.InputSystem.dll">
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateTimberbornInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(TimberbornInstallDir)' == ''"
      Text="TimberbornInstallDir is not set. Copy Directory.Build.local.props.example to Directory.Build.local.props and set your install path, or set the LEDGELOGGING_TIMBERBORN_DIR environment variable, or pass -p:TimberbornInstallDir=&lt;path&gt;." />
    <Error
      Condition="'$(TimberbornInstallDir)' != '' AND !Exists('$(TimberbornManagedDir)')"
      Text="Timberborn Managed directory not found at '$(TimberbornManagedDir)'. Check that TimberbornInstallDir ('$(TimberbornInstallDir)') points at the root of your Timberborn install (the folder containing Timberborn_Data\Managed\)." />
  </Target>

  <!--
    After build, drop LedgeLogging.dll + manifest.json into the user's
    Timberborn Mods folder so the game picks it up on next launch. Disable
    with -p:LedgeLoggingDeploy=false. Unlike Keystone there is no Unity asset
    side: this mod ships no blueprints/sprites/loc, so the manifest is
    hand-authored in the repo and deployed here — no Unity Mod Builder needed.
  -->
  <Target Name="DeployLedgeLogging" AfterTargets="Build" Condition="'$(LedgeLoggingDeploy)' != 'false'">
    <ItemGroup>
      <_LedgeLoggingDeployFile Include="$(TargetDir)LedgeLogging.dll" />
      <_LedgeLoggingDeployFile Include="$(LedgeLoggingManifestPath)" />
    </ItemGroup>
    <MakeDir Directories="$(LedgeLoggingDeployDir)" />
    <Copy SourceFiles="@(_LedgeLoggingDeployFile)" DestinationFolder="$(LedgeLoggingDeployDir)" SkipUnchangedFiles="true" />
    <Message Text="Ledge Logging deployed to $(LedgeLoggingDeployDir)" Importance="high" />
  </Target>

</Project>
