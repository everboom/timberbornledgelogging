<Project TreatAsLocalProperty="Configuration">

  <!--
    Repository-wide MSBuild defaults for Ledge Logging.

    Override mechanism for the Timberborn install path (no committed default —
    the path is machine-specific and stays out of git):
      1. Pass -p:TimberbornInstallDir=<path> on the dotnet command line.
      2. Set the LEDGELOGGING_TIMBERBORN_DIR environment variable.
      3. Create Directory.Build.local.props (gitignored — copy from
         Directory.Build.local.props.example) and set TimberbornInstallDir.

    Resolution order is highest-precedence first; the first non-empty value wins.

    Optional: LEDGELOGGING_DEPLOY_DIR redirects the post-build deploy somewhere
    other than %USERPROFILE%\Documents\Timberborn\Mods\LedgeLogging.
  -->

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Force Release for every build, regardless of what `-c` is passed. The
    deployed Mods folder is the only thing the running game JITs, and we don't
    use Debug.Assert or [Conditional("DEBUG")] guards, so Debug builds buy us
    nothing. TreatAsLocalProperty="Configuration" on <Project> above strips the
    "global" flag from any Configuration set by `dotnet build -c X`, letting
    this unconditional assignment win.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
  </PropertyGroup>

  <PropertyGroup Label="Timberborn paths">
    <TimberbornInstallDir Condition="'$(TimberbornInstallDir)' == '' AND '$(LEDGELOGGING_TIMBERBORN_DIR)' != ''">$(LEDGELOGGING_TIMBERBORN_DIR)</TimberbornInstallDir>
    <TimberbornManagedDir Condition="'$(TimberbornInstallDir)' != ''">$(TimberbornInstallDir)\Timberborn_Data\Managed</TimberbornManagedDir>
  </PropertyGroup>

  <PropertyGroup Label="Mod deploy paths">
    <LedgeLoggingDeployDir Condition="'$(LedgeLoggingDeployDir)' == '' AND '$(LEDGELOGGING_DEPLOY_DIR)' != ''">$(LEDGELOGGING_DEPLOY_DIR)</LedgeLoggingDeployDir>
    <LedgeLoggingDeployDir Condition="'$(LedgeLoggingDeployDir)' == ''">$(USERPROFILE)\Documents\Timberborn\Mods\LedgeLogging</LedgeLoggingDeployDir>
    <LedgeLoggingManifestPath>$(MSBuildThisFileDirectory)manifest.json</LedgeLoggingManifestPath>
  </PropertyGroup>

</Project>
